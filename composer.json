{
    "name": "thekaziomar/laravel-atomic-cache",
    "description": "Zero-headache, stampede-proof, and auto-invalidating caching for Laravel. Cache database queries in 2 lines without managing keys or observers.",
    "keywords": [
        "laravel",
        "cache",
        "eloquent",
        "query-cache",
        "auto-invalidation",
        "stampede-protection",
        "redis",
        "compression",
        "performance"
    ],
    "homepage": "https://github.com/kaziomarsh24/laravel-atomic-cache",
    "license": "MIT",
    "authors": [
        {
            "name": "Kazi Omar Faruk",
            "email": "softeng.kaziomar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "ext-zlib": "Required for payload gzip compression on large cache items."
    },
    "autoload": {
        "psr-4": {
            "KaziOmar\\AtomicCache\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "KaziOmar\\AtomicCache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KaziOmar\\AtomicCache\\AtomicCacheServiceProvider"
            ],
            "aliases": {
                "AtomicCache": "KaziOmar\\AtomicCache\\Facades\\AtomicCache"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false,
                "ignore": [
                    "laravel/framework"
                ]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
